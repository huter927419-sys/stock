<Window x:Class="MQReceiver.Views.FilterMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鑲＄エ杩囨护缁撴灉 - 涓婚潰鏉? Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E1E">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 鏍囬鏍?-->
        <Border Grid.Row="0" Background="#252526" Padding="12" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="鑲＄エ杩囨护缁撴灉" FontSize="18" FontWeight="SemiBold" Foreground="#D4D4D4" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding LastUpdateTime, StringFormat='鏈€鍚庢洿鏂? {0:yyyy-MM-dd HH:mm:ss}'}"
                           FontSize="11" Foreground="#858585" VerticalAlignment="Center"/>

                <!-- MQ鏈嶅姟鎸夐挳 -->
                <Button x:Name="MQServiceButton" Content="鍚姩MQ鏈嶅姟" Margin="20,0,0,0"
                        Click="MQServiceButton_Click" Width="100" Height="32"
                        Background="#2D7D46" Foreground="#FFFFFF" BorderBrush="#3D8D56">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2D7D46"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#3D8D56"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D9D56"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- MQ鐘舵€佹寚绀哄櫒 -->
                <Ellipse x:Name="MQStatusIndicator" Width="10" Height="10" Fill="#6E6E6E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="MQStatusText" Text="MQ鏈惎鍔? FontSize="10" Foreground="#858585" VerticalAlignment="Center" Margin="4,0,0,0"/>

                <!-- 鍒嗛殧绗?-->
                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="15,0,15,0"/>

                <!-- 杩囨护鏈嶅姟鎸夐挳 -->
                <Button x:Name="FilterServiceButton" Content="鍚姩杩囨护" Margin="0,0,0,0"
                        Click="FilterServiceButton_Click" Width="100" Height="32"
                        Background="#7D5D2D" Foreground="#FFFFFF" BorderBrush="#8D6D3D">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#7D5D2D"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#8D6D3D"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#9D7D4D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 杩囨护鐘舵€佹寚绀哄櫒 -->
                <Ellipse x:Name="FilterStatusIndicator" Width="10" Height="10" Fill="#6E6E6E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="FilterStatusText" Text="杩囨护鏈惎鍔? FontSize="10" Foreground="#858585" VerticalAlignment="Center" Margin="4,0,0,0"/>

                <!-- 鍒嗛殧绗?-->
                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="15,0,15,0"/>

                <!-- 缂撳瓨鐘舵€佹樉绀?-->
                <TextBlock x:Name="CacheCountText" Text="缂撳瓨鏁版嵁: 0 鍙偂绁? FontSize="10" Foreground="#858585" VerticalAlignment="Center"/>
                <TextBlock x:Name="CacheUpdateTimeText" Text="鏇存柊鏃堕棿: 浠庢湭鏇存柊" FontSize="10" Foreground="#6E6E6E" VerticalAlignment="Center" Margin="10,0,0,0"/>

                <!-- 鍒嗛殧绗?-->
                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="15,0,15,0"/>

                <!-- 鏁版嵁鐘舵€佹樉绀?-->
                <Ellipse x:Name="DataStatusIndicator" Width="10" Height="10" Fill="#6E6E6E" VerticalAlignment="Center"/>
                <TextBlock x:Name="DataStatusText" Text="鏁版嵁鐘舵€? 鏈煡" FontSize="10" Foreground="#858585" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBlock x:Name="TradingSessionText" Text="" FontSize="10" Foreground="#6E6E6E" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <!-- 鍒嗛殧绗?-->
                <Rectangle Width="1" Height="20" Fill="#3F3F46" Margin="15,0,15,0"/>

                <Button Content="鍒锋柊" Margin="0,0,0,0"
                        Click="RefreshButton_Click" Width="80" Height="32"
                        Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="#5A5A5A">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3F3F46"/>
                            <Setter Property="Foreground" Value="#D4D4D4"/>
                            <Setter Property="BorderBrush" Value="#5A5A5A"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4A4A4A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="鍏抽棴" HorizontalAlignment="Right" Margin="10,0,0,0"
                        Click="CloseButton_Click" Width="60" Height="32"
                        Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="#5A5A5A">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3F3F46"/>
                            <Setter Property="Foreground" Value="#D4D4D4"/>
                            <Setter Property="BorderBrush" Value="#5A5A5A"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4A4A4A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 鍏釜闈㈡澘锛團low甯冨眬锛屾牴鎹獥鍙ｅ搴﹁嚜鍔ㄦ崲琛岋級 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="#1E1E1E">
            <StackPanel>
                <!-- 鍏ㄥ眬M1/M2/M3闃堝€奸厤缃尯鍩?-->
                <Border Background="#252526" Margin="10,10,10,5" Padding="15" BorderBrush="#4A9EFF" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="鍏ㄥ眬闃堝€艰缃紙閫傜敤浜庢墍鏈?涓繃婊ゆ潯浠讹級" FontSize="13" FontWeight="SemiBold" Foreground="#D4D4D4" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="M1(榛樿78):" FontSize="11" Foreground="#B8B8B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding GlobalM1, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="24" FontSize="11"
                                     Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="#5A5A5A" Padding="4" Margin="0,0,15,0"/>

                            <TextBlock Text="M2(榛樿65):" FontSize="11" Foreground="#B8B8B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding GlobalM2, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="24" FontSize="11"
                                     Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="#5A5A5A" Padding="4" Margin="0,0,15,0"/>

                            <TextBlock Text="M3(榛樿50):" FontSize="11" Foreground="#B8B8B8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding GlobalM3, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="24" FontSize="11"
                                     Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="#5A5A5A" Padding="4" Margin="0,0,15,0"/>

                            <TextBlock Text="{Binding GlobalThresholdDisplay}" FontSize="11" Foreground="#4A9EFF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 鍏釜琛ㄦ牸鐨刉rapPanel -->
                <WrapPanel Orientation="Horizontal"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="10">

                <!-- 琛ㄦ牸涓€锛氬己澶氶噾鍙?-->
                <Border BorderBrush="#4A9EFF" BorderThickness="1.5"
                        CornerRadius="4"
                        Margin="8"
                        Padding="12"
                        Width="320"
                        Background="#2D2D30">
                    <StackPanel>
                        <TextBlock Text="琛ㄦ牸涓€锛氬己澶氶噾鍙?
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#B8B8B8"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Table1Count, StringFormat='鍏?{0} 鍙偂绁?}"
                                   FontSize="11"
                                   Foreground="#6E6E6E"
                                   Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding Table1Results}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  MaxHeight="500"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  Tag="1"
                                  Background="#2D2D30"
                                  Foreground="#D4D4D4"
                                  BorderBrush="#3F3F46"
                                  RowBackground="#2D2D30"
                                  AlternatingRowBackground="#252526"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  >
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#3F3F46"/>
                                    <Setter Property="Foreground" Value="#B8B8B8"/>
                                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Foreground" Value="#D4D4D4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3F3F46"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="鍚嶇О" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Cursor="Hand"
                                                       MouseLeftButtonDown="StockName_MouseLeftButtonDown"
                                                       Tag="{Binding StockCode}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StockName}">
                                                <Hyperlink Foreground="#6A9EFF">
                                                    <Run Text="{Binding StockName}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="娑ㄥ箙" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PriceChangeDisplay}"
                                                       Foreground="{Binding PriceChangeColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="鍛↘" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WeeklyK, StringFormat=F2}"
                                                       Foreground="{Binding WeeklyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="鏈圞" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MonthlyK, StringFormat=F2}"
                                                       Foreground="{Binding MonthlyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="瀛" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding QuarterlyK, StringFormat=F2}"
                                                       Foreground="{Binding QuarterlyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 琛ㄦ牸浜岋細涓閲戝弶 -->
                <Border BorderBrush="#FF6B6B" BorderThickness="1.5"
                        CornerRadius="4"
                        Margin="8"
                        Padding="12"
                        Width="320"
                        Background="#2D2D30">
                    <StackPanel>
                        <TextBlock Text="琛ㄦ牸浜岋細涓閲戝弶"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#B8B8B8"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Table2Count, StringFormat='鍏?{0} 鍙偂绁?}"
                                   FontSize="11"
                                   Foreground="#6E6E6E"
                                   Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding Table2Results}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  MaxHeight="500"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  Tag="2"
                                  Background="#2D2D30"
                                  Foreground="#D4D4D4"
                                  BorderBrush="#3F3F46"
                                  RowBackground="#2D2D30"
                                  AlternatingRowBackground="#252526"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  >
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#3F3F46"/>
                                    <Setter Property="Foreground" Value="#B8B8B8"/>
                                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Foreground" Value="#D4D4D4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3F3F46"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="鍚嶇О" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Cursor="Hand"
                                                       MouseLeftButtonDown="StockName_MouseLeftButtonDown"
                                                       Tag="{Binding StockCode}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StockName}">
                                                <Hyperlink Foreground="#6A9EFF">
                                                    <Run Text="{Binding StockName}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="娑ㄥ箙" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PriceChangeDisplay}"
                                                       Foreground="{Binding PriceChangeColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="鍛↘" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WeeklyK, StringFormat=F2}"
                                                       Foreground="{Binding WeeklyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="鏈圞" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MonthlyK, StringFormat=F2}"
                                                       Foreground="{Binding MonthlyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="瀛" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding QuarterlyK, StringFormat=F2}"
                                                       Foreground="{Binding QuarterlyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- 琛ㄦ牸涓夛細寮哄鎺掑垪 -->
                <Border BorderBrush="#4ECDC4" BorderThickness="1.5"
                        CornerRadius="4"
                        Margin="8"
                        Padding="12"
                        Width="320"
                        Background="#2D2D30">
                    <StackPanel>
                        <TextBlock Text="琛ㄦ牸涓夛細寮哄鎺掑垪"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#B8B8B8"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Table3Count, StringFormat='鍏?{0} 鍙偂绁?}"
                                   FontSize="11"
                                   Foreground="#6E6E6E"
                                   Margin="0,0,0,12"/>

                        <DataGrid ItemsSource="{Binding Table3Results}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="All"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  MaxHeight="500"
                                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                                  Tag="3"
                                  Background="#2D2D30"
                                  Foreground="#D4D4D4"
                                  BorderBrush="#3F3F46"
                                  RowBackground="#2D2D30"
                                  AlternatingRowBackground="#252526"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  >
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#3F3F46"/>
                                    <Setter Property="Foreground" Value="#B8B8B8"/>
                                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Foreground" Value="#D4D4D4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3F3F46"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="鍚嶇О" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Cursor="Hand"
                                                       MouseLeftButtonDown="StockName_MouseLeftButtonDown"
                                                       Tag="{Binding StockCode}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StockName}">
                                                <Hyperlink Foreground="#6A9EFF">
                                                    <Run Text="{Binding StockName}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="娑ㄥ箙" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PriceChangeDisplay}"
                                                       Foreground="{Binding PriceChangeColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="鍛↘" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WeeklyK, StringFormat=F2}"
                                                       Foreground="{Binding WeeklyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="鏈圞" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MonthlyK, StringFormat=F2}"
                                                       Foreground="{Binding MonthlyKColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="瀛" Width="50">
