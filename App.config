<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- MQ接收器配置 -->
    <add key="MQPort" value="5678" />
    <add key="MQQueueName" value="daily_data_queue" />
    
    <!-- PostgreSQL 数据库配置 -->
    <add key="DatabaseHost" value="localhost" />
    <add key="DatabasePort" value="8532" />
    <add key="DatabaseName" value="stockdb" />
    <add key="DatabaseUser" value="postgres" />
    <add key="DatabasePassword" value="cd123321" />
    
    <!-- Redis 缓存配置 -->
    <add key="RedisHost" value="localhost" />
    <add key="RedisPort" value="6379" />
    <add key="RedisPassword" value="" />
    <add key="RedisDatabase" value="0" />
    
    <!-- 预加载服务配置 -->
    <add key="PreloadService_BatchSize" value="100" />
    <add key="PreloadService_MaxParallelism" value="4" />
    
    <!-- 过滤器服务配置 -->
    <add key="FilterService_IntervalMinutes" value="30" />
    <add key="FilterService_OutputFile" value="filter_results.txt" />
    
    <!-- ========== 面板1：周K、月K、季K 金叉过滤配置 ========== -->
    <add key="Filter1_RequireWeeklyGoldenCross" value="true" />
    <add key="Filter1_RequireMonthlyGoldenCross" value="true" />
    <add key="Filter1_RequireQuarterlyGoldenCross" value="true" />
    <!-- 面板1的默认最小值（显示在表头，列表中的值必须大于此值） -->
    <add key="Filter1_WeeklyKDefaultMin" value="30" />
    <add key="Filter1_MonthlyKDefaultMin" value="25" />
    <add key="Filter1_QuarterlyKDefaultMin" value="20" />
    <!-- 面板1的其他过滤条件 -->
    <add key="Filter1_WeeklyKMin" value="0" />
    <add key="Filter1_WeeklyKMax" value="100" />
    <add key="Filter1_MonthlyKMin" value="0" />
    <add key="Filter1_MonthlyKMax" value="100" />
    <add key="Filter1_QuarterlyKMin" value="0" />
    <add key="Filter1_QuarterlyKMax" value="100" />
    <add key="Filter1_PriceMin" value="0.01" />
    <add key="Filter1_VolumeMin" value="0" />
    
    <!-- ========== 面板2：周K>月K>季K（不含金叉）配置 ========== -->
    <!-- 面板2的默认最小值（显示在表头，列表中的值必须大于此值） -->
    <add key="Filter2_WeeklyKDefaultMin" value="35" />
    <add key="Filter2_MonthlyKDefaultMin" value="30" />
    <add key="Filter2_QuarterlyKDefaultMin" value="25" />
    <!-- 面板2的其他过滤条件 -->
    <add key="Filter2_WeeklyKMin" value="0" />
    <add key="Filter2_WeeklyKMax" value="100" />
    <add key="Filter2_MonthlyKMin" value="0" />
    <add key="Filter2_MonthlyKMax" value="100" />
    <add key="Filter2_QuarterlyKMin" value="0" />
    <add key="Filter2_QuarterlyKMax" value="100" />
    <add key="Filter2_PriceMin" value="0.01" />
    <add key="Filter2_VolumeMin" value="0" />
    
    <!-- ========== 面板3：月K>季K or 周K<月K 配置 ========== -->
    <!-- 面板3的默认最小值（显示在表头，列表中的值必须大于此值） -->
    <add key="Filter3_WeeklyKDefaultMin" value="30" />
    <add key="Filter3_MonthlyKDefaultMin" value="25" />
    <add key="Filter3_QuarterlyKDefaultMin" value="20" />
    <!-- 面板3的其他过滤条件 -->
    <add key="Filter3_WeeklyKMin" value="0" />
    <add key="Filter3_WeeklyKMax" value="100" />
    <add key="Filter3_MonthlyKMin" value="0" />
    <add key="Filter3_MonthlyKMax" value="100" />
    <add key="Filter3_QuarterlyKMin" value="0" />
    <add key="Filter3_QuarterlyKMax" value="100" />
    <add key="Filter3_PriceMin" value="0.01" />
    <add key="Filter3_VolumeMin" value="0" />

    <!-- ========== 面板4：月K<季K AND 周K>季K（不含上穿当天）配置 ========== -->
    <!-- 面板4的默认最小值（显示在表头，列表中的值必须大于此值） -->
    <add key="Filter4_WeeklyKDefaultMin" value="30" />
    <add key="Filter4_MonthlyKDefaultMin" value="25" />
    <add key="Filter4_QuarterlyKDefaultMin" value="20" />
    <!-- 面板4的其他过滤条件 -->
    <add key="Filter4_WeeklyKMin" value="0" />
    <add key="Filter4_WeeklyKMax" value="100" />
    <add key="Filter4_MonthlyKMin" value="0" />
    <add key="Filter4_MonthlyKMax" value="100" />
    <add key="Filter4_QuarterlyKMin" value="0" />
    <add key="Filter4_QuarterlyKMax" value="100" />
    <add key="Filter4_PriceMin" value="0.01" />
    <add key="Filter4_VolumeMin" value="0" />

    <!-- ========== 面板5：月K>季K AND 周K<月K 配置 ========== -->
    <!-- 面板5的默认最小值（显示在表头，列表中的值必须大于此值） -->
    <add key="Filter5_WeeklyKDefaultMin" value="30" />
    <add key="Filter5_MonthlyKDefaultMin" value="25" />
    <add key="Filter5_QuarterlyKDefaultMin" value="20" />
    <!-- 面板5的其他过滤条件 -->
    <add key="Filter5_WeeklyKMin" value="0" />
    <add key="Filter5_WeeklyKMax" value="100" />
    <add key="Filter5_MonthlyKMin" value="0" />
    <add key="Filter5_MonthlyKMax" value="100" />
    <add key="Filter5_QuarterlyKMin" value="0" />
    <add key="Filter5_QuarterlyKMax" value="100" />
    <add key="Filter5_PriceMin" value="0.01" />
    <add key="Filter5_VolumeMin" value="0" />

    <!-- ========== 面板6：月K<季K AND 周K<季K 配置 ========== -->
    <!-- 面板6的默认最小值（显示在表头，列表中的值必须大于此值） -->
    <add key="Filter6_WeeklyKDefaultMin" value="30" />
    <add key="Filter6_MonthlyKDefaultMin" value="25" />
    <add key="Filter6_QuarterlyKDefaultMin" value="20" />
    <!-- 面板6的其他过滤条件 -->
    <add key="Filter6_WeeklyKMin" value="0" />
    <add key="Filter6_WeeklyKMax" value="100" />
    <add key="Filter6_MonthlyKMin" value="0" />
    <add key="Filter6_MonthlyKMax" value="100" />
    <add key="Filter6_QuarterlyKMin" value="0" />
    <add key="Filter6_QuarterlyKMax" value="100" />
    <add key="Filter6_PriceMin" value="0.01" />
    <add key="Filter6_VolumeMin" value="0" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Channels" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.5" newVersion="8.0.0.5" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>

