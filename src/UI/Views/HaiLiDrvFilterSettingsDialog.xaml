<Window x:Class="MQReceiver.Views.HaiLiDrvFilterSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据筛选设置" Height="280" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2D2D30">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 涨幅筛选 -->
        <CheckBox x:Name="ChkEnableChangePercent" Grid.Row="0" Content="启用涨幅筛选"
                  Foreground="White" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,0,12">
            <TextBlock Text="最小涨幅（%）：" Foreground="White" VerticalAlignment="Center" Width="120"/>
            <TextBox x:Name="TxtMinChangePercent" Width="100" Padding="4,2" Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
        </StackPanel>

        <!-- 日内涨幅筛选 -->
        <CheckBox x:Name="ChkEnableIntradayChange" Grid.Row="2" Content="启用日内涨幅筛选（现价相对开盘价）"
                  Foreground="White" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="20,0,0,12">
            <TextBlock Text="最小日内涨幅（%）：" Foreground="White" VerticalAlignment="Center" Width="140"/>
            <TextBox x:Name="TxtMinIntradayChange" Width="100" Padding="4,2" Background="#3F3F46" Foreground="White" BorderBrush="#555"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="多条件为“或”关系，满足其一即通过。" Foreground="#B8B8B8" FontSize="11" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnReset" Content="重置" Width="80" Height="28" Margin="0,0,10,0"
                    Click="BtnReset_Click" Background="#5A5A5A" Foreground="White" BorderThickness="0"/>
            <Button Name="BtnCancel" Content="取消" Width="80" Height="28" Margin="0,0,10,0"
                    Click="BtnCancel_Click" IsCancel="True" Background="#5A5A5A" Foreground="White" BorderThickness="0"/>
            <Button Name="BtnOk" Content="确定" Width="80" Height="28"
                    Click="BtnOk_Click" IsDefault="True" Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
