<Window x:Class="MQReceiver.Views.StartupMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="股票数据管理系统 - 启动菜单" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#252526" Padding="20,15" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="股票数据管理系统" FontSize="24" FontWeight="Bold" Foreground="#D4D4D4" HorizontalAlignment="Center"/>
                <TextBlock Text="版本 2.1" FontSize="12" Foreground="#858585" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 菜单选项 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                <TextBlock Text="请选择要启动的功能：" FontSize="14" Foreground="#D4D4D4" Margin="0,0,0,20"/>
                <TextBlock Text="注意：主程序启动时会自动启动MQ数据接收服务" FontSize="11" Foreground="#6B6B6B" Margin="0,0,0,15" FontStyle="Italic"/>

                <!-- 选项1：主程序 -->
                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" 
                        Margin="0,0,0,15" Padding="15" MouseEnter="MenuOption_MouseEnter" MouseLeave="MenuOption_MouseLeave"
                        MouseLeftButtonDown="MainProgram_MouseLeftButtonDown" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="[1] 主程序（计算器）" FontSize="16" FontWeight="SemiBold" Foreground="#4A9EFF" Margin="0,0,0,8"/>
                        <TextBlock Text="• MQ数据接收服务（自动启动）" FontSize="12" Foreground="#B8B8B8" Margin="0,2"/>
                        <TextBlock Text="• 启动股票计算服务" FontSize="12" Foreground="#B8B8B8" Margin="0,2"/>
                        <TextBlock Text="• 显示6个计算条件的结果" FontSize="12" Foreground="#B8B8B8" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- 选项2：HaiLiDrv独立窗口 -->
                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" 
                        Margin="0,0,0,15" Padding="15" MouseEnter="MenuOption_MouseEnter" MouseLeave="MenuOption_MouseLeave"
                        MouseLeftButtonDown="HaiLiDrv_MouseLeftButtonDown" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="[2] HaiLiDrv数据窗口（独立模式）" FontSize="16" FontWeight="SemiBold" Foreground="#4A9EFF" Margin="0,0,0,8"/>
                        <TextBlock Text="• 独立运行，使用独立配置文件" FontSize="12" Foreground="#B8B8B8" Margin="0,2"/>
                        <TextBlock Text="• 实时数据（交易时间）或日线数据（收盘后）" FontSize="12" Foreground="#B8B8B8" Margin="0,2"/>
                        <TextBlock Text="• 自动在附加屏显示" FontSize="12" Foreground="#B8B8B8" Margin="0,2"/>
                        <TextBlock Text="• 双击股票行打开K线图" FontSize="12" Foreground="#B8B8B8" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- 选项3：MQ数据服务（已移除，主程序启动时自动启动） -->
                <!-- MQ数据接收服务现在在主程序启动时自动启动，无需单独选择 -->

                <!-- 选项4：退出 -->
                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" 
                        Margin="0,0,0,0" Padding="15" MouseEnter="MenuOption_MouseEnter" MouseLeave="MenuOption_MouseLeave"
                        MouseLeftButtonDown="Exit_MouseLeftButtonDown" Cursor="Hand">
                    <StackPanel>
                        <TextBlock Text="[0] 退出" FontSize="16" FontWeight="SemiBold" Foreground="#FF6B6B" Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部提示 -->
        <Border Grid.Row="2" Background="#252526" Padding="15" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="提示：点击上方选项启动对应功能，或使用键盘数字键快速选择" 
                           FontSize="11" Foreground="#858585" TextAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="注意：启动菜单会保持打开，可以同时运行多个窗口" 
                           FontSize="10" Foreground="#6B6B6B" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
