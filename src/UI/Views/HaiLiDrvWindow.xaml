<Window x:Class="MQReceiver.Views.HaiLiDrvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="海利驱动数据窗口" Height="800" Width="1200"
        WindowStartupLocation="Manual"
        Background="#1E1E1E"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10,5" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Name="RefreshButton" Content="刷新数据" Width="100" Height="30" Margin="5,0" 
                        Click="RefreshButton_Click" Background="#007ACC" Foreground="White" BorderThickness="0"/>
                <Button Name="ConfigStockCodesButton" Content="配置股票代码" Width="120" Height="30" Margin="10,0,0,0"
                        Click="ConfigStockCodesButton_Click" Background="#5A5A5A" Foreground="#D4D4D4" BorderThickness="0"/>
                <TextBlock Text="搜索:" Margin="20,0,5,0" VerticalAlignment="Center" 
                           Foreground="#B8B8B8" FontSize="12"/>
                <TextBox Name="SearchTextBox" Width="200" Height="28" Margin="5,0,0,0"
                         Background="#1E1E1E" Foreground="#D4D4D4" 
                         BorderBrush="#3F3F46" BorderThickness="1"
                         FontSize="12" Padding="5,0"
                         TextChanged="SearchTextBox_TextChanged"
                         KeyDown="SearchTextBox_KeyDown"
                         ToolTip="输入股票代码或名称进行搜索（支持部分匹配）">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Name="ClearSearchButton" Content="清除" Width="60" Height="28" Margin="5,0,0,0"
                        Click="ClearSearchButton_Click" Background="#3F3F46" Foreground="#D4D4D4" BorderThickness="0"
                        Visibility="Collapsed"/>
                <TextBlock Name="StatusText" Text="就绪" Margin="20,0,0,0" VerticalAlignment="Center" 
                           Foreground="#B8B8B8" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 面板容器（使用ScrollViewer包装WrapPanel以支持滚动） -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto"
                      Background="#1E1E1E">
            <WrapPanel Name="PanelsContainer" 
                       Orientation="Horizontal"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="10,5" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
            <TextBlock Name="InfoText" Text="等待数据..." Foreground="#B8B8B8" FontSize="11"/>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
</Window>
