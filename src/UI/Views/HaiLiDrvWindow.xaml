<Window x:Class="MQReceiver.Views.HaiLiDrvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MQReceiver.Converters"
        Title="海利驱动数据窗口" Height="800" Width="1200"
        MinWidth="800" MaxWidth="1200"
        WindowStartupLocation="Manual"
        Background="#1E1E1E"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <converters:LessThanZeroConverter x:Key="LessThanZeroConverter"/>
        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏（与 MairuiStockMonitor 一致：连接、主题、筛选） -->
        <Menu Grid.Row="0" Background="#282828" Foreground="White" Height="24" VerticalAlignment="Top">
            <MenuItem Header="连接">
                <MenuItem x:Name="MenuStartReceive" Header="启动接收" Click="MenuStartReceive_Click"/>
                <MenuItem x:Name="MenuStopReceive" Header="停止接收" Click="MenuStopReceive_Click"/>
                <Separator/>
                <MenuItem Header="退出应用" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="主题">
                <MenuItem x:Name="MenuDarkTheme" Header="深色主题" IsCheckable="True" IsChecked="True" Click="MenuDarkTheme_Click"/>
                <MenuItem x:Name="MenuLightTheme" Header="浅色主题" IsCheckable="True" Click="MenuLightTheme_Click"/>
            </MenuItem>
            <MenuItem Header="筛选">
                <MenuItem x:Name="MenuGlobalFilter" Header="全局筛选设置" Click="MenuGlobalFilter_Click"/>
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem x:Name="MenuShowDataPanel" Header="显示数据面板" IsCheckable="True" IsChecked="True" Click="MenuShowDataPanel_Click"/>
                <MenuItem x:Name="MenuShowLogPanel" Header="显示日志面板" IsCheckable="True" IsChecked="True" Click="MenuShowLogPanel_Click"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="10,5" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Name="RefreshButton" Content="刷新数据" Width="100" Height="30" Margin="5,0" 
                        Click="RefreshButton_Click" Background="#007ACC" Foreground="White" BorderThickness="0"/>
                <!-- 配置股票代码按钮已隐藏（不需要全局过滤，使用Boards.json配置面板） -->
                <!-- <Button Name="ConfigStockCodesButton" Content="配置股票代码" Width="120" Height="30" Margin="10,0,0,0"
                        Click="ConfigStockCodesButton_Click" Background="#5A5A5A" Foreground="#D4D4D4" BorderThickness="0"/> -->
                <TextBlock Text="搜索:" Margin="20,0,5,0" VerticalAlignment="Center" 
                           Foreground="#B8B8B8" FontSize="12"/>
                <TextBox Name="SearchTextBox" Width="200" Height="28" Margin="5,0,0,0"
                         Background="#1E1E1E" Foreground="#D4D4D4" 
                         BorderBrush="#3F3F46" BorderThickness="1"
                         FontSize="12" Padding="5,0"
                         TextChanged="SearchTextBox_TextChanged"
                         KeyDown="SearchTextBox_KeyDown"
                         ToolTip="输入股票代码或名称进行搜索（支持部分匹配）">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Name="ClearSearchButton" Content="清除" Width="60" Height="28" Margin="5,0,0,0"
                        Click="ClearSearchButton_Click" Background="#3F3F46" Foreground="#D4D4D4" BorderThickness="0"
                        Visibility="Collapsed"/>
                <TextBlock Name="StatusText" Text="就绪" Margin="20,0,0,0" VerticalAlignment="Center" 
                           Foreground="#B8B8B8" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 主内容：数据面板（表格+板块）+ 日志面板（与 Mairui 一致） -->
        <Grid Grid.Row="2" Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="100"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="200" MinHeight="80"/>
            </Grid.RowDefinitions>
            <Border x:Name="DataPanelBorder" Grid.Row="0" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PanelsContainer" Orientation="Horizontal"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Top"
                               Margin="5,8,5,5"/>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#3F3F46"/>
            <Border x:Name="LogPanelBorder" Grid.Row="2" Visibility="Visible"
                    Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,2">
                        <TextBlock Text="日志" Foreground="#D4D4D4" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearLog" Content="清空日志" Width="70" Height="22" Margin="15,0,0,0"
                                Click="BtnClearLog_Click" Background="#5A5A5A" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="5"
                             Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#2D2D30" Padding="10,5" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
            <TextBlock Name="InfoText" Text="等待数据..." Foreground="#B8B8B8" FontSize="11"/>
        </Border>
    </Grid>
</Window>
