<UserControl x:Class="MQReceiver.Views.HaiLiDrvPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MQReceiver.Converters"
             Background="#252526" BorderBrush="#3F3F46" BorderThickness="1"
             MinWidth="300" MinHeight="200" Margin="8,8,8,8"
             HorizontalAlignment="Left" VerticalAlignment="Top">
    <UserControl.Resources>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <converters:LessThanZeroConverter x:Key="LessThanZeroConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 面板标题栏 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="5,3" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <TextBlock Name="PanelTitleText" Text="面板1" 
                       Foreground="#D4D4D4" FontSize="12" FontWeight="Bold"/>
        </Border>

        <!-- 数据列表 -->
        <DataGrid Name="DataListGrid" Grid.Row="1" 
                  AutoGenerateColumns="False"
                  Background="#1E1E1E" 
                  Foreground="#D4D4D4"
                  BorderBrush="#3F3F46" BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  RowBackground="#1E1E1E" AlternatingRowBackground="#252526">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="代码" Binding="{Binding StockCode}" Width="70"/>
                <DataGridTemplateColumn Header="名称" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Cursor="Hand"
                                       MouseLeftButtonDown="StockName_MouseLeftButtonDown"
                                       Tag="{Binding StockCode}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       FontSize="11"
                                       ToolTip="{Binding StockName}">
                                <Hyperlink Foreground="#6A9EFF">
                                    <Run Text="{Binding StockName}"/>
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="最新价" Binding="{Binding NewPrice, StringFormat=F2}" Width="60"/>
                <DataGridTextColumn Header="涨跌幅" Width="60">
                    <DataGridTextColumn.Binding>
                        <Binding Path="PriceChange" StringFormat="{}{0:F2}%"/>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#D4D4D4"/>
                            <Style.Triggers>
                                <!-- 涨：红色 -->
                                <DataTrigger Binding="{Binding PriceChange, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                    <Setter Property="Foreground" Value="#FF4444"/>
                                </DataTrigger>
                                <!-- 跌：绿色 -->
                                <DataTrigger Binding="{Binding PriceChange, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                    <Setter Property="Foreground" Value="#00CC66"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="成交量" Binding="{Binding Volume, StringFormat=N0}" Width="*" MinWidth="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
