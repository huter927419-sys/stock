<Window x:Class="MQReceiver.Views.HaiLiDrvStockCodeConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置股票代码" Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 添加股票方式 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="添加股票方式：" Foreground="#D4D4D4" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="AddMethodComboBox" Width="160" Height="26" 
                      Background="#2D2D30" Foreground="#D4D4D4" 
                      SelectionChanged="AddMethodComboBox_SelectionChanged">
                <ComboBoxItem Content="手动输入代码" IsSelected="True"/>
                <ComboBoxItem Content="从数据列表选择"/>
            </ComboBox>
        </StackPanel>

        <!-- 添加区域：手动输入 或 从列表选择 -->
        <Border x:Name="AddAreaBorder" Grid.Row="1" Background="#252526" Padding="10,8" Margin="0,0,0,8" 
                BorderBrush="#3F3F46" BorderThickness="1">
            <Grid>
                <!-- 手动输入 -->
                <StackPanel x:Name="ManualInputPanel" Orientation="Horizontal">
                    <TextBox x:Name="ManualCodeTextBox" Width="280" Height="28" Margin="0,0,8,0"
                             Background="#1E1E1E" Foreground="#D4D4D4" 
                             BorderBrush="#3F3F46" BorderThickness="1"
                             FontFamily="Consolas" FontSize="11" Padding="5,0"
                             ToolTip="输入股票代码，多个用逗号或空格分隔"/>
                    <Button x:Name="AddManualButton" Content="添加" Width="70" Height="28"
                            Click="AddManualButton_Click" Background="#007ACC" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <!-- 从数据列表选择 -->
                <StackPanel x:Name="FromListPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <ListBox x:Name="AvailableStocksListBox" Width="320" Height="140" Margin="0,0,8,0"
                             SelectionMode="Extended" Background="#1E1E1E" Foreground="#D4D4D4"
                             BorderBrush="#3F3F46" BorderThickness="1"
                             DisplayMemberPath="DisplayText"/>
                    <StackPanel VerticalAlignment="Center">
                        <Button x:Name="AddSelectedButton" Content="添加选中" Width="80" Height="28" Margin="0,0,0,8"
                                Click="AddSelectedButton_Click" Background="#0E639C" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="AvailableCountText" Text="0 只可选" Foreground="#858585" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 当前已选股票 -->
        <Border Grid.Row="2" Background="#252526" Padding="8" Margin="0,0,0,8" 
                BorderBrush="#3F3F46" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="当前已选股票：" Foreground="#D4D4D4" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="DeleteSelectedButton" Content="删除选中" Width="80" Height="26" Margin="12,0,0,0"
                            Click="DeleteSelectedButton_Click" Background="#5A5A5A" Foreground="#D4D4D4" BorderThickness="0"/>
                    <Button x:Name="ClearAllButton" Content="清空" Width="60" Height="26" Margin="8,0,0,0"
                            Click="ClearAllButton_Click" Background="#3F3F46" Foreground="#D4D4D4" BorderThickness="0"/>
                    <TextBlock x:Name="SelectedCountText" Text="0 个" Foreground="#4A9EFF" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="SelectedCodesListBox" Grid.Row="1" 
                         SelectionMode="Extended" Background="#1E1E1E" Foreground="#D4D4D4"
                         BorderBrush="#3F3F46" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- 提示信息 -->
        <Border Grid.Row="3" Background="#252526" Padding="10,8" Margin="0,0,0,8" 
                BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <CheckBox x:Name="EnableFilterCheckBox" Content="启用股票代码过滤（只显示配置的股票）" 
                          Foreground="#D4D4D4" FontSize="11" Margin="0,0,0,5"/>
                <TextBlock Text="提示：手动输入可粘贴多行或逗号分隔的代码；“从数据列表选择”需在主界面先加载数据后再打开本对话框。" 
                           Foreground="#858585" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 占位（原说明区可省略） -->
        <Grid Grid.Row="4"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="保存" Width="80" Height="30" Margin="0,0,10,0"
                    Click="SaveButton_Click" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="30"
                    Click="CancelButton_Click" Background="#3F3F46" Foreground="#D4D4D4" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
