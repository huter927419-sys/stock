<Window x:Class="MQReceiver.Views.HaiLiDrvStockCodeConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置股票代码" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 说明 -->
        <TextBlock Grid.Row="0" Text="配置要显示的股票代码（每行一个，或逗号分隔）：" 
                   Foreground="#D4D4D4" FontSize="12" Margin="0,0,0,10"/>

        <!-- 股票代码输入框 -->
        <TextBox Name="StockCodesTextBox" Grid.Row="1" 
                 Background="#2D2D30" Foreground="#D4D4D4" 
                 BorderBrush="#3F3F46" BorderThickness="1"
                 AcceptsReturn="True" AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas" FontSize="11"
                 TextWrapping="Wrap"/>

        <!-- 提示信息 -->
        <Border Grid.Row="2" Background="#252526" Padding="10,8" Margin="0,10,0,10" 
                BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3">
            <StackPanel>
                <CheckBox Name="EnableFilterCheckBox" Content="启用股票代码过滤（只显示配置的股票）" 
                          Foreground="#D4D4D4" FontSize="11" Margin="0,0,0,5"/>
                <TextBlock Text="提示：如果启用过滤，只显示配置的股票代码；如果禁用，显示全部股票。" 
                           Foreground="#858585" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock Name="StockCountText" Text="当前配置：0 个股票代码" 
                           Foreground="#4A9EFF" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="SaveButton" Content="保存" Width="80" Height="30" Margin="0,0,10,0"
                    Click="SaveButton_Click" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            <Button Name="CancelButton" Content="取消" Width="80" Height="30"
                    Click="CancelButton_Click" Background="#3F3F46" Foreground="#D4D4D4" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
