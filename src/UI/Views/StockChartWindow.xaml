<Window x:Class="MQReceiver.Views.StockChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="股票图表" Height="1050" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StockName}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StockCode}" FontSize="14" Foreground="#ECF0F1" VerticalAlignment="Center"/>
                <Button Content="关闭" HorizontalAlignment="Right" Margin="10,0,0,0" Click="CloseButton_Click" Width="60"/>
            </StackPanel>
        </Border>

        <!-- 主图：日K线图 + 成交量（合并到同一个图表，成交量在底部） -->
        <GroupBox Grid.Row="1" Header="日K线图" Margin="5" Padding="2">
            <lvc:CartesianChart Series="{Binding CombinedSeries}"
                                Zoom="X" Pan="X" Hoverable="True" DisableAnimations="True"
                                DataTooltip="{x:Null}">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding KlineLabels}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="5" Stroke="#E0E0E0"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="价格" Position="RightTop"
                              MinValue="{Binding KlinePriceMin}"
                              MaxValue="{Binding KlinePriceMax}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Stroke="#E0E0E0"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </GroupBox>

        <!-- 副图1：周KD指标（K线-白色，D线-黄色）-->
        <GroupBox Grid.Row="2" Header="周KD（K-白 D-黄）" Margin="5,2" Padding="2">
            <lvc:CartesianChart Series="{Binding WeeklyKDSeries}"
                                Zoom="X" Hoverable="True" DisableAnimations="True"
                                DataTooltip="{x:Null}" Background="#1A1A1A">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding KDLabels}" ShowLabels="False">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="5" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis MinValue="0" MaxValue="100" Position="RightTop">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="20" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </GroupBox>

        <!-- 副图2：月KD指标 -->
        <GroupBox Grid.Row="3" Header="月KD（K-白 D-黄）" Margin="5,2" Padding="2">
            <lvc:CartesianChart Series="{Binding MonthlyKDSeries}"
                                Zoom="X" Hoverable="True" DisableAnimations="True"
                                DataTooltip="{x:Null}" Background="#1A1A1A">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding KDLabels}" ShowLabels="False">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="5" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis MinValue="0" MaxValue="100" Position="RightTop">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="20" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </GroupBox>

        <!-- 副图3：季KD指标 -->
        <GroupBox Grid.Row="4" Header="季KD（K-白 D-黄）" Margin="5,2" Padding="2">
            <lvc:CartesianChart Series="{Binding QuarterlyKDSeries}"
                                Zoom="X" Hoverable="True" DisableAnimations="True"
                                DataTooltip="{x:Null}" Background="#1A1A1A">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding KDLabels}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="5" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis MinValue="0" MaxValue="100" Position="RightTop">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="20" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </GroupBox>

        <!-- 副图4：KD带状图叠加（周-红 月-绿 季-蓝）-->
        <GroupBox Grid.Row="5" Header="KD带状图（周-红 | 月-绿 | 季-蓝 | K&gt;D深色 K&lt;D浅色）" Margin="5,2" Padding="2">
            <lvc:CartesianChart Series="{Binding KDBandSeries}"
                                Zoom="X" Hoverable="True" DisableAnimations="True"
                                DataTooltip="{x:Null}" Background="#1A1A1A">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding KDLabels}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="5" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis MinValue="0" MaxValue="100" Position="RightTop">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="20" Stroke="#333333"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </GroupBox>
    </Grid>
</Window>
