<Window x:Class="MQReceiver.Views.StockChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="股票图表" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StockName}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StockCode}" FontSize="14" Foreground="#ECF0F1" VerticalAlignment="Center"/>
                <Button Content="关闭" HorizontalAlignment="Right" Margin="10,0,0,0" Click="CloseButton_Click" Width="60"/>
            </StackPanel>
        </Border>

        <!-- 图表1：日K线图 -->
        <GroupBox Grid.Row="1" Header="日K线图" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <!-- K线图 -->
                <lvc:CartesianChart Grid.Row="0" Series="{Binding KlineSeries}"
                                    Zoom="X" Hoverable="True"
                                    DataTooltip="{x:Null}">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="日期" Labels="{Binding KlineLabels}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="价格" Position="RightTop"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <!-- 成交量图 -->
                <lvc:CartesianChart Grid.Row="1" Series="{Binding VolumeSeries}"
                                    Zoom="X" Hoverable="True"
                                    DataTooltip="{x:Null}">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding KlineLabels}">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="成交量" Position="RightTop"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </GroupBox>

        <!-- 图表2：KD指标K值叠加图 -->
        <GroupBox Grid.Row="2" Header="KD指标K值叠加图（周K-蓝 | 月K-绿 | 季K-红）" Margin="5">
            <lvc:CartesianChart Series="{Binding KDValueSeries}"
                                Zoom="X" Hoverable="True"
                                DataTooltip="{x:Null}">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="日期" Labels="{Binding KDLabels}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="K值" MinValue="0" MaxValue="100" Position="RightTop"/>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </GroupBox>

        <!-- 图表3：KD指标带状图叠加图 -->
        <GroupBox Grid.Row="3" Header="KD指标带状图叠加图（K&gt;D红色 | K&lt;D蓝色）" Margin="5">
            <lvc:CartesianChart Series="{Binding KDBandSeries}"
                                Zoom="X" Hoverable="True"
                                DataTooltip="{x:Null}">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="日期" Labels="{Binding KDLabels}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Step="1"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="KD值" MinValue="0" MaxValue="100" Position="RightTop"/>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </GroupBox>
    </Grid>
</Window>
