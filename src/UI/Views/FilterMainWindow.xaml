                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="过滤器执行日志" FontSize="12" FontWeight="SemiBold" Foreground="#B8B8B8"/>
                        <Button Content="清空" Margin="20,0,0,0" Click="ClearLogButton_Click"
                                Width="50" Height="22" FontSize="10"
                                Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="#5A5A5A">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="隐藏" Margin="8,0,0,0" Click="HideLogButton_Click"
                                Width="50" Height="22" FontSize="10"
                                Background="#3F3F46" Foreground="#D4D4D4" BorderBrush="#5A5A5A">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 日志内容 -->
                <TextBox x:Name="LogTextBox" Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11"
                         Padding="8"/>
            </Grid>
        </Border>
    </Grid>
</Window>
